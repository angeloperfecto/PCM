rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "angeloperfecto.epc@gmail.com" ||
        request.auth.token.email == "president@pcm.edu.ph" ||
        request.auth.token.email == "admin@pcm.ph" ||
        request.auth.token.admin == true
      );
    }

    // Public readable assets for website visitors
    match /pcm/media-library/{folder}/{allPaths=**} {
      allow read: if true;
      allow write: if (
        request.resource.size < 20 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('application/pdf') ||
         request.resource.contentType.matches('video/.*'))
      );
      allow delete: if true;
    }

    match /slideshow/{allPaths=**} {
      allow read: if true;
      allow write: if (
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*')
      );
      allow delete: if true;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if (
        request.resource.size < 25 * 1024 * 1024
      );
    }
  }
}
