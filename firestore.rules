rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-by-default safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Public readable institutional content & Admin CMS manageable collections
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if true;
    }

    match /faculty/{facultyId} {
      allow read: if true;
      allow write: if true;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if true;
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if true;
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    match /sermons/{sermonId} {
      allow read: if true;
      allow write: if true;
    }

    match /scrapbook/{scrapbookId} {
      allow read: if true;
      allow write: if true;
    }

    match /mediaItems/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    match /galleryAlbums/{albumId} {
      allow read: if true;
      allow write: if true;
    }

    match /adminUsers/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    match /activityLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /studentProfiles/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Prospective student applications
    match /applications/{applicationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
