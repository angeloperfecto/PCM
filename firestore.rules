rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "angeloperfecto.epc@gmail.com" ||
        request.auth.token.email == "president@pcm.edu.ph" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Super Admin" &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ["Active", "Approved"])
      );
    }

    function isApprovedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "angeloperfecto.epc@gmail.com" ||
        request.auth.token.email == "president@pcm.edu.ph" ||
        request.auth.token.email == "admin@pcm.ph" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["Super Admin", "Admin", "Staff/Editor", "Editor", "Content Admin", "Academic Admin", "Registrar", "Finance"] &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ["Active", "Approved"]) ||
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.status in ["Active", "Approved"])
      );
    }

    function isAdmin() {
      return isApprovedAdmin();
    }

    // Public readable content collections (Website CMS)
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow write: if true;
    }

    match /slideshowImages/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faculty/{facultyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sermons/{sermonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /scrapbook/{scrapbookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mediaLibrary/{mediaId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    match /mediaItems/{mediaId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    match /galleryAlbums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // YouTube Video Management & Homepage Video Settings
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepageVideoConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Authenticated Users and Profiles
    // Direct document lookup for user's own profile; list queries restricted to Admin
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isApprovedAdmin());
      allow list: if isApprovedAdmin() || true;
      allow create: if true;
      allow update: if true;
      allow delete: if resource.data.email != "angeloperfecto.epc@gmail.com";
    }

    // Deleted Users Archive & Restoration Audit
    match /deletedUsers/{deletedId} {
      allow read: if true;
      allow write: if true;
    }

    match /studentProfiles/{studentId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /preEnlistments/{preEnlistmentId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /addDropRequests/{requestId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /academicPeriods/{periodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feeSchedules/{feeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enrollmentSystemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /studentNotifications/{notifId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /adminUsers/{adminId} {
      allow get, list: if isApprovedAdmin() || (isSignedIn() && request.auth.uid == adminId) || true;
      allow write: if isSuperAdmin() || isApprovedAdmin() || true;
    }

    match /applications/{applicationId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Donation Management
    match /donationPaymentMethods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /donationSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isSignedIn() || isAdmin();
    }

    // Default fallback
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }
  }
}

