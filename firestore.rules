rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // Identity and admin levels
    //
    // adminLevel() is the single place a user's admin standing is worked out:
    //   3 = Super Admin
    //   2 = Admin (may approve, reject and manage admin accounts, except Super Admin)
    //   1 = other approved admin roles (Editor, Content Admin, Registrar, Finance, ...):
    //       may manage website content, but not accounts or roles
    //   0 = everyone else, including pending, rejected and disabled accounts
    // lib/serverAuth.ts mirrors this logic for the server API routes.
    // ---------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // The signed-in user's email, lower-cased, only once Firebase has verified it.
    function verifiedEmail() {
      return isSignedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', null) != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isActiveStatus(s) {
      return s in ['Active', 'Approved'];
    }

    function isBlockedStatus(s) {
      return s in ['Rejected', 'Disabled', 'Inactive'];
    }

    function adminRoles() {
      return ['Super Admin', 'Admin', 'Staff/Editor', 'Editor', 'Content Admin', 'Academic Admin', 'Registrar', 'Finance'];
    }

    function levelOfRole(role) {
      return role == 'Super Admin' ? 3 : role == 'Admin' ? 2 : role in adminRoles() ? 1 : 0;
    }

    function maxOf(a, b) {
      return a > b ? a : b;
    }

    function docData(path) {
      return exists(path) ? get(path).data : {};
    }

    function profileDoc() {
      return docData(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function adminUserDoc() {
      return docData(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    // adminEmails/{email} is the index the site keeps of active adminUsers entries, so
    // admins listed by email (not by uid) are recognised here.
    function emailIndexDoc() {
      return verifiedEmail() == ''
        ? {}
        : docData(/databases/$(database)/documents/adminEmails/$(verifiedEmail()));
    }

    // Approved accounts store role 'Admin' with the assigned role in adminRole.
    function effectiveRole(data) {
      return data.get('adminRole', '') in adminRoles() ? data.get('adminRole', '') : data.get('role', '');
    }

    // Admin role granted by the directory: the email index, or adminUsers/{uid}.
    function directoryRoleFrom(a, idx) {
      return idx.get('active', false) == true
        ? idx.get('role', '')
        : (a.size() > 0
            && isActiveStatus(a.get('status', 'Active'))
            && a.get('role', '') in adminRoles()
          ? a.get('role', '')
          : '');
    }

    // u = users/{uid}, a = adminUsers/{uid}, idx = adminEmails/{verified email}.
    // A rejected, disabled or inactive profile blocks admin access entirely; the two
    // built-in Super Admin addresses always keep access.
    function levelFrom(email, u, a, idx) {
      return email in ['angeloperfecto.epc@gmail.com', 'president@pcm.edu.ph']
        ? 3
        : isBlockedStatus(u.get('status', ''))
          ? 0
          : maxOf(
              u.get('role', '') in adminRoles() && isActiveStatus(u.get('status', ''))
                ? levelOfRole(effectiveRole(u))
                : 0,
              levelOfRole(directoryRoleFrom(a, idx))
            );
    }

    function adminLevel() {
      return !isSignedIn() ? 0 : levelFrom(verifiedEmail(), profileDoc(), adminUserDoc(), emailIndexDoc());
    }

    function directoryRole() {
      return !isSignedIn() ? '' : directoryRoleFrom(adminUserDoc(), emailIndexDoc());
    }

    function isAdmin() {
      return adminLevel() >= 1;
    }

    function isSuperAdmin() {
      return adminLevel() == 3;
    }

    // ---------------------------------------------------------------------------
    // Website CMS content: anyone can read, only approved admins can change.
    // ---------------------------------------------------------------------------

    match /systemConfig/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /siteConfig/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /siteContent/{id}             { allow read: if true; allow write: if isAdmin(); }
    match /slideshowImages/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /programs/{id}                { allow read: if true; allow write: if isAdmin(); }
    match /faculty/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /news/{id}                    { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}                  { allow read: if true; allow write: if isAdmin(); }
    match /downloads/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /stats/{id}                   { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{id}                    { allow read: if true; allow write: if isAdmin(); }
    match /sermons/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /scrapbook/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /mediaLibrary/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /mediaItems/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /galleryAlbums/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /studentLifePhotos/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /videos/{id}                  { allow read: if true; allow write: if isAdmin(); }
    match /homepageVideoConfig/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /academicPeriods/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /academicSubjects/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id}                { allow read: if true; allow write: if isAdmin(); }
    match /classSections/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /sections/{id}                { allow read: if true; allow write: if isAdmin(); }
    match /instructors/{id}             { allow read: if true; allow write: if isAdmin(); }
    match /feeStructure/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /feeSchedules/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /enrollmentSettings/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /enrollmentSystemConfig/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /donationPaymentMethods/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /donationSettings/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /deletedUsers/{id}            { allow read: if true; allow write: if isAdmin(); }

    match /studentLifeAlbums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
      match /photos/{photoId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Upload metadata written by the /api/media/upload server route (which has no user
    // session). New records only; changing or removing them needs an admin.
    match /uploadedMedia/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Public form submissions: anyone can submit, only admins can change or remove.
    // ---------------------------------------------------------------------------

    match /applications/{id}            { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /inquiries/{id}               { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /newsletterSubscribers/{id}   { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /donations/{id}               { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /activityLogs/{id}            { allow read, create: if true; allow update, delete: if isAdmin(); }

    // ---------------------------------------------------------------------------
    // Student portal records. The portal signs students in without Firebase Auth, so
    // these stay writable; deleting records requires an admin.
    // ---------------------------------------------------------------------------

    match /studentProfiles/{id}         { allow read, create, update: if true; allow delete: if isAdmin(); }
    match /enrollments/{id}             { allow read, create, update: if true; allow delete: if isAdmin(); }
    match /preEnlistments/{id}          { allow read, create, update: if true; allow delete: if isAdmin(); }
    match /addDropRequests/{id}         { allow read, create, update: if true; allow delete: if isAdmin(); }
    match /studentNotifications/{id}    { allow read, create, update: if true; allow delete: if isAdmin(); }
    match /uploadedDocuments/{id}       { allow read, create, update: if true; allow delete: if isAdmin(); }

    // ---------------------------------------------------------------------------
    // Accounts, registration and approval
    // ---------------------------------------------------------------------------

    // Roles and statuses a user may give their own profile. New admin registrations
    // are 'Pending User' / 'Pending' and stay that way until an approver changes them.
    function selfRoles() {
      return ['Student/User', 'Student', 'Pending User'];
    }

    function selfStatuses() {
      return ['Active', 'Approved', 'Pending', 'Pending Verification'];
    }

    function isSelfSafeProfile(data) {
      return data.get('role', 'Student/User') in selfRoles()
        && data.get('status', 'Active') in selfStatuses()
        && data.get('adminRole', null) == null;
    }

    function roleFieldsUnchanged() {
      return request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('adminRole', null) == resource.data.get('adminRole', null)
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null);
    }

    // A non-admin may move between the self roles (e.g. link a Student ID, or request
    // admin access as a Pending User) but never into an admin role, and a rejected or
    // disabled account can't reactivate itself.
    function isSelfSafeRoleChange() {
      return !(resource.data.get('role', '') in adminRoles())
        && resource.data.get('status', 'Active') in selfStatuses()
        && request.resource.data.get('role', '') in selfRoles()
        && request.resource.data.get('status', 'Active') in selfStatuses()
        && request.resource.data.get('adminRole', null) == resource.data.get('adminRole', null);
    }

    // A user listed in the admin directory by an approver may record exactly that role
    // on their own profile (the site does this on their first sign-in).
    function claimsDirectoryRole(data, dirRole) {
      return dirRole != ''
        && data.get('role', '') in adminRoles()
        && effectiveRole(data) == dirRole
        && isActiveStatus(data.get('status', ''));
    }

    function isSuperAdminData(data) {
      return data.get('role', '') == 'Super Admin' || data.get('adminRole', '') == 'Super Admin';
    }

    // Approving, rejecting and changing accounts: Super Admin, or an Admin for anything
    // that doesn't involve the Super Admin role.
    function canManageUser(level, isCreate) {
      return level == 3
        || (level == 2
          && !isSuperAdminData(request.resource.data)
          && (isCreate || !isSuperAdminData(resource.data)));
    }

    function userCreateAllowed(userId, level, dirRole) {
      return canManageUser(level, true)
        || (isSignedIn() && request.auth.uid == userId
          && (isSelfSafeProfile(request.resource.data)
            || claimsDirectoryRole(request.resource.data, dirRole)));
    }

    function userUpdateAllowed(userId, level, dirRole) {
      return canManageUser(level, false)
        || (isSignedIn() && request.auth.uid == userId
          && (roleFieldsUnchanged()
            || isSelfSafeRoleChange()
            || (!isBlockedStatus(resource.data.get('status', ''))
              && claimsDirectoryRole(request.resource.data, dirRole))));
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if userCreateAllowed(userId, adminLevel(), directoryRole());
      allow update: if userUpdateAllowed(userId, adminLevel(), directoryRole());
      allow delete: if canDeleteAccount(adminLevel(), resource.data);
    }

    function canDeleteAccount(level, data) {
      return level == 3 || (level == 2 && !isSuperAdminData(data));
    }

    // Admin directory. Super Admin and Admin may add, change or remove entries (only a
    // Super Admin for Super Admin entries). Any admin may edit their own entry's details,
    // but not its role, status or email.
    function adminEntryChangeAllowed(level) {
      return level == 3
        || (level == 2
          && request.resource.data.get('role', '') != 'Super Admin'
          && resource.data.get('role', '') != 'Super Admin');
    }

    function isOwnAdminEntry(adminId) {
      return adminId == request.auth.uid
        || (verifiedEmail() != '' && resource.data.get('email', '').lower() == verifiedEmail());
    }

    match /adminUsers/{adminId} {
      allow read: if true;
      allow create: if adminLevel() == 3
        || (adminLevel() == 2 && request.resource.data.get('role', '') != 'Super Admin');
      allow delete: if canDeleteAccount(adminLevel(), resource.data);
      allow update: if adminEntryChangeAllowed(adminLevel())
        || (isAdmin()
          && isOwnAdminEntry(adminId)
          && request.resource.data.get('role', null) == resource.data.get('role', null)
          && request.resource.data.get('status', null) == resource.data.get('status', null)
          && request.resource.data.get('email', null) == resource.data.get('email', null));
    }

    // Email index of active admins, maintained by Super Admin and Admin sessions (see
    // store.tsx). Only a Super Admin may write Super Admin entries.
    match /adminEmails/{email} {
      allow read: if isSignedIn();
      allow create: if adminLevel() == 3
        || (adminLevel() == 2 && request.resource.data.get('role', '') != 'Super Admin');
      allow update: if adminEntryChangeAllowed(adminLevel());
      allow delete: if adminLevel() == 3
        || (adminLevel() == 2 && resource.data.get('role', '') != 'Super Admin');
    }

    // No catch-all: rules from every matching block are OR-ed, so a wildcard here would
    // override the checks above. Collections not listed are denied by default.
  }
}
