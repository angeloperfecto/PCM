rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "angeloperfecto.epc@gmail.com" ||
        request.auth.token.email == "president@pcm.edu.ph" ||
        request.auth.token.email == "admin@pcm.ph" ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Admin")
      );
    }

    // Public readable content collections (Website CMS)
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faculty/{facultyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sermons/{sermonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /scrapbook/{scrapbookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mediaItems/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galleryAlbums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Authenticated Users and Profiles
    // Direct document lookup for user's own profile; list queries restricted to Admin
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /studentProfiles/{studentId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    match /adminUsers/{adminId} {
      allow get, list: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow write: if isAdmin();
    }

    match /applications/{applicationId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Donation Management
    match /donationPaymentMethods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /donationSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isSignedIn() || isAdmin();
    }

    // Default fallback
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }
  }
}

